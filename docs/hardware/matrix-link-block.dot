digraph g {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, bgcolor="white",
         pad=0.5, nodesep=0.45, ranksep=1.0,
         label="UniversalKeyboard — blocos funcionais (nets de sinal, sem alimentacao)", labelloc=t, fontsize=15];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8, color="#475569"];

  subgraph cluster_host {
    label="Link com o Pi"; style="rounded,dashed"; color="#94a3b8";
    "J1" [label="J1\nConn_01x06"];
  }
  subgraph cluster_mcu {
    label="MCU (3V3)"; style="rounded,dashed"; color="#94a3b8";
    "U1" [label="U1\nATmega328P-PU"];
  }
  subgraph cluster_sr {
    label="Shift registers"; style="rounded,dashed"; color="#94a3b8";
    "U2" [label="U2\n74HC595"];
    "U3" [label="U3\n74HC595"];
    "U4" [label="U4\n74HC165"];
  }
  subgraph cluster_clock {
    label="Clock e reset"; style="rounded,dashed"; color="#94a3b8";
    "Y1" [label="Y1\n8MHz"];
    "C1" [label="C1\n22pF"];
    "C2" [label="C2\n22pF"];
    "R1" [label="R1\n10k"];
    "J2" [label="J2\nConn_01x06"];
  }
  subgraph cluster_status {
    label="Status"; style="rounded,dashed"; color="#94a3b8";
    "LED1" [label="LED1\nLED"];
    "R2" [label="R2\n330R"];
  }

  "LED1" -> "R2" [label="LED_A", dir=none, penwidth=1.3];
  "J1" -> "U1" [label="PI_RX", dir=none, penwidth=1.3];
  "J1" -> "U1" [label="PI_TX", dir=none, penwidth=1.3];
  "J2" -> "R1" [label="RESET", dir=none, penwidth=1.3];
  "J2" -> "U1" [label="RESET", dir=none, penwidth=1.3];
  "R1" -> "U1" [label="RESET", dir=none, penwidth=1.3];
  "U2" -> "U3" [label="SR_CASCADE", dir=none, penwidth=1.3];
  "U1" -> "U2" [label="SR_CLK", dir=none, penwidth=1.3];
  "U1" -> "U3" [label="SR_CLK", dir=none, penwidth=1.3];
  "U1" -> "U4" [label="SR_CLK", dir=none, penwidth=1.3];
  "U2" -> "U3" [label="SR_CLK", dir=none, penwidth=1.3];
  "U2" -> "U4" [label="SR_CLK", dir=none, penwidth=1.3];
  "U3" -> "U4" [label="SR_CLK", dir=none, penwidth=1.3];
  "U1" -> "U4" [label="SR_DATA_IN", dir=none, penwidth=1.3];
  "U1" -> "U2" [label="SR_DS", dir=none, penwidth=1.3];
  "U1" -> "U2" [label="SR_LATCH", dir=none, penwidth=1.3];
  "U1" -> "U3" [label="SR_LATCH", dir=none, penwidth=1.3];
  "U2" -> "U3" [label="SR_LATCH", dir=none, penwidth=1.3];
  "U1" -> "U4" [label="SR_LOAD", dir=none, penwidth=1.3];
  "R2" -> "U1" [label="STATUS_LED", dir=none, penwidth=1.3];
  "C1" -> "U1" [label="XTAL1", dir=none, penwidth=1.3];
  "C1" -> "Y1" [label="XTAL1", dir=none, penwidth=1.3];
  "U1" -> "Y1" [label="XTAL1", dir=none, penwidth=1.3];
  "C2" -> "U1" [label="XTAL2", dir=none, penwidth=1.3];
  "C2" -> "Y1" [label="XTAL2", dir=none, penwidth=1.3];
  "U1" -> "Y1" [label="XTAL2", dir=none, penwidth=1.3];

  "COL0..13" [shape=box, style="rounded,filled", fillcolor="#ecfdf5", color="#065f46", label="COL0..13\npara a matriz"];
  "ROW0..7" [shape=box, style="rounded,filled", fillcolor="#ecfdf5", color="#065f46", label="ROW0..7\npara a matriz"];
  "U2" -> "COL0..13" [dir=none, color="#065f46", style=dashed];
  "U3" -> "COL0..13" [dir=none, color="#065f46", style=dashed];
  "ROW0..7" -> "U4" [dir=none, color="#065f46", style=dashed];
}
